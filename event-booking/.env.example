# Event Booking Mobile — Environment Variables
#
# Copy this file to .env and fill in your values.
# DO NOT commit .env to version control.

# API base URL (optional — overrides auto-detection from Expo)
# Leave empty to auto-detect from Expo Go Metro connection.
# Use this for production/staging or custom setups.
# EXPO_PUBLIC_API_URL=http://192.168.1.100:8000

# API port (default: 8000)
# EXPO_PUBLIC_API_PORT=8000
